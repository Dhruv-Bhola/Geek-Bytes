# Secure Evidence DMS Server Environment Configuration
# ---------------------------------------------------------------------------
# NEVER commit a real .env. Copy this template to server/.env and replace
# every `replace_with_*` placeholder with a value you generate locally.
#
#   cp server/.env.example server/.env
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dms_db

# JWT Authentication (generate a secret >= 32 chars)
JWT_SECRET=replace_with_secure_jwt_secret_min_32_chars
JWT_EXPIRES_IN=24h
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=dms

# Encryption (AES-256-GCM 32-byte key, hex-encoded = 64 hex chars)
AES_256_KEY=replace_with_32_byte_hex_key_for_aes_256
SHA_256_SALT=replace_with_sha256_salt

# AWS S3 (Evidence Storage) — optional, local disk used when unset
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dms-evidence
AWS_ACCESS_KEY_ID=replace_with_aws_access_key
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_key

# Blockchain Relayer (local Hardhat node + deployed EvidenceAuditLedger)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
RELAYER_PRIVATE_KEY=replace_with_anvil_account_private_key

# AI Engine (FastAPI)
AI_ENGINE_URL=http://localhost:8000
FASTAPI_AI_URL=http://localhost:8000

# TEE (Trusted Execution Environment)
TEE_ENABLED=false
