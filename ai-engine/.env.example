# Secure Evidence DMS AI Engine Environment Configuration
# ---------------------------------------------------------------------------
# NEVER commit a real .env. Copy this template to ai-engine/.env and replace
# every placeholder with a value you generate locally.
#
#   cp ai-engine/.env.example ai-engine/.env
# ---------------------------------------------------------------------------

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Secure Evidence DMS API Gateway
DMS_API_URL=http://localhost:5000
DMS_API_KEY=replace_with_shared_api_key

# Model Paths (optional; deterministic heuristics used when unavailable)
TROCR_MODEL_PATH=./models/trocr-base-printed
LEGAL_BERT_MODEL_PATH=./models/legal-bert-base
SUMMARIZER_MODEL_PATH=./models/bart-large-cnn

# OCR
TESSERACT_CMD=/usr/bin/tesseract

# Blockchain
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Storage
TEMP_UPLOAD_DIR=/tmp/dms_uploads
MAX_FILE_SIZE_MB=100
